@using _25dh110017_Mystore.Models.ViewModel
@model HomeProductVM

<style>
    .feature-container {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 15px !important;
        padding: 0 !important;
        margin-top: 15px !important;
    }

    .fproduct-item {
        background: #0b0f19 !important; /* Đổi nền thành màu tối Cyberpunk */
        border: 1px solid rgba(0, 242, 254, 0.3) !important; /* Viền sáng neon xanh nhẹ */
        border-radius: 10px !important;
        padding: 12px !important;
        width: calc(20% - 12px) !important;
        min-width: 180px !important;
        box-sizing: border-box !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: space-between !important;
        box-shadow: 0 0 15px rgba(0, 242, 254, 0.1) !important;
        transition: transform 0.2s, box-shadow 0.2s !important;
    }

        .fproduct-item:hover {
            transform: translateY(-3px) !important;
            border-color: #00f2fe !important;
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.3) !important;
        }

        .fproduct-item img {
            width: 100% !important;
            height: 160px !important;
            object-fit: contain !important;
            border-radius: 6px !important;
            margin-bottom: 8px !important;
            background: #070913 !important;
        }

    .prodName {
        font-size: 14px !important;
        font-weight: 600 !important;
        color: #ffffff !important; /* Đổi chữ tên sách thành màu trắng sáng */
        height: 40px !important;
        overflow: hidden !important;
        display: -webkit-box !important;
        -webkit-line-clamp: 2 !important;
        -webkit-box-orient: vertical !important;
        margin-bottom: 6px !important;
    }

    .prodPrice {
        font-size: 15px !important;
        font-weight: bold !important;
        color: #ff3366 !important; /* Màu giá tiền nổi bật trên nền tối */
        margin-bottom: 4px !important;
    }

    .prodSale {
        font-size: 12px !important;
        color: #8a99ad !important; /* Màu xám sáng dễ nhìn */
        margin-bottom: 10px !important;
    }

    .btn-buy {
        display: block !important;
        width: 100% !important;
        padding: 6px 0 !important;
        background-color: rgba(0, 242, 254, 0.1) !important;
        color: #00f2fe !important; /* Chữ nút Mua ngay màu xanh neon */
        border: 1px solid #00f2fe !important;
        border-radius: 4px !important;
        text-align: center !important;
        font-weight: 600 !important;
        font-size: 13px !important;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

        .btn-buy:hover {
            background-color: #00f2fe !important;
            color: #0b0f19 !important;
            box-shadow: 0 0 10px #00f2fe;
        }
</style>

@if (Model != null &&
     Model.FeaturedProducts != null &&
     Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd my-3">
        <h3 class="mb-3 font-weight-bold text-info" style="text-shadow: 0 0 8px #00f2fe;">
            ⚡ Sản phẩm nổi bật
        </h3>

        <div class="feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="fproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@(product.ProductImage.StartsWith("http")
                                ? product.ProductImage
                                : Url.Content("~/Images/" + product.ProductImage))"
                                 alt="@product.ProductName"
                                 onerror="this.src='https://picsum.photos/seed/@product.ProductID/200/200'" />
                        </a>

                        <p class="prodName">
                            @product.ProductName
                        </p>

                        <p class="prodPrice">
                            @string.Format("{0:N0}₫", product.ProductPrice)
                        </p>

                        <p class="prodSale">
                            ★ 5 • Đã bán
                            @(product.OrderDetails != null
                                ? product.OrderDetails.Count()
                                : 0)
                        </p>
                    </div>

                    <div>
                        <a href="@Url.Action("AddToCart", "Cart", new { id = product.ProductID })"
                           class="btn-buy">
                            Mua ngay
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <hr class="border-secondary opacity-25 my-4" />
}